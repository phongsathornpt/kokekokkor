package web

import "strconv"

templ Sidebar(data DashboardData) {
	<aside class="w-64 min-w-[16rem] bg-[#090b11] border-r border-[#1a1d25] flex flex-col sticky top-0 h-screen p-5 z-50 shrink-0">
		<div class="flex items-center gap-3 pb-4 mb-3 border-b border-[#1a1d25]">
			<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-600 to-indigo-400 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 shrink-0">
				@IconLogo("w-5 h-5")
			</div>
			<div class="flex flex-col min-w-0">
				<div class="flex items-center gap-1.5">
					<span class="text-sm font-bold tracking-tight text-white">kokekokkor</span>
					<span class="text-[10px] font-semibold bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 px-1.5 py-0.5 rounded-full">v1.27</span>
				</div>
				<span class="text-[11px] text-gray-400 truncate leading-tight">Gateway administration · secrets are never rendered</span>
			</div>
		</div>

		<nav class="flex-1 flex flex-col gap-1 overflow-y-auto pr-1">
			<div class="text-[10px] font-bold uppercase tracking-wider text-gray-500 mt-2 mb-1 px-2">Gateway Core</div>
			<a href="#overview" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all">
				@IconCube("w-4 h-4 text-indigo-400")
				<span>Overview</span>
			</a>
			<a href="#providers" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all">
				@IconServer("w-4 h-4 text-indigo-400")
				<span>Providers</span>
				<span class="ml-auto text-[11px] font-semibold bg-[#191c26] text-gray-400 px-2 py-0.5 rounded-full border border-[#262933]">{ strconv.Itoa(len(data.Providers)) }</span>
			</a>
			<a href="#defaults" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all">
				@IconSliders("w-4 h-4 text-indigo-400")
				<span>Protocol Defaults</span>
			</a>
			<a href="#routes" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all">
				@IconRoute("w-4 h-4 text-sky-400")
				<span>Model Routes</span>
				<span class="ml-auto text-[11px] font-semibold bg-[#191c26] text-gray-400 px-2 py-0.5 rounded-full border border-[#262933]">{ strconv.Itoa(len(data.Routes)) }</span>
			</a>

			<div class="text-[10px] font-bold uppercase tracking-wider text-gray-500 mt-5 mb-1 px-2">Security & Storage</div>
			<div class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-gray-400 cursor-default rounded-lg">
				@IconShieldCheck("w-4 h-4 text-emerald-400")
				<span>AES-256 Vault</span>
				<span class="ml-auto text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20">Sealed</span>
			</div>
		</nav>

		<div class="mt-auto pt-4 border-t border-[#1a1d25] flex flex-col gap-3">
			<div class="flex items-center gap-2 text-xs font-medium text-gray-300 bg-emerald-500/10 border border-emerald-500/20 px-3 py-2 rounded-lg">
				<span class="pulse-dot"></span>
				<span>Gateway Active</span>
				<span class="ml-auto font-mono text-[11px] text-gray-400">:8080</span>
			</div>
			<div class="flex items-center justify-between pt-1">
				<div class="flex items-center gap-2">
					<div class="w-7 h-7 rounded-lg bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 flex items-center justify-center text-xs font-bold">
						A
					</div>
					<span class="text-xs font-semibold text-gray-200">admin</span>
				</div>
				<form method="post" action="/admin/logout">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<button type="submit" class="p-1.5 text-gray-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors cursor-pointer" title="Sign out">
						@IconSignOut("w-4 h-4")
					</button>
				</form>
			</div>
		</div>
	</aside>
}
