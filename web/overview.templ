package web

import "strconv"

// defaultBound mirrors what the gateway considers ready: a protocol with a
// bound upstream. Rendered as bound/total.
func defaultBound(data DashboardData) string {
	bound := 0
	for _, def := range data.Defaults {
		if def.ProviderID != "" {
			bound++
		}
	}
	return strconv.Itoa(bound) + "/" + strconv.Itoa(len(data.Defaults))
}

templ Overview(data DashboardData) {
	@AdminShell("kokekokkor admin - overview", data) {
		@PageTitle("Overview", "Routing state for this gateway: which upstreams are live, where each model alias fails over, and the upstream a protocol falls back to when no alias matches.")

		<section class="mt-8 grid grid-cols-1 gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-4" aria-label="Gateway vitals">
			@Vital("Providers", strconv.Itoa(len(data.Providers)), "configured upstream targets")
			@Vital("Model routes", strconv.Itoa(len(data.Routes)), "aliases with a fallback chain")
			@Vital("Protocol defaults", defaultBound(data), "protocols with a bound upstream")
			@Vital("Credential vault", "sealed", "AES-256, secrets never rendered")
		</section>

		<section class="mt-12">
			<div class="flex flex-wrap items-end justify-between gap-3 pb-3">
				<div>
					<h2 class="text-sm font-semibold text-ink">Upstream providers</h2>
					<p class="mt-1 text-[11px] text-ink-3">Every target this gateway can route to, with its credential state.</p>
				</div>
				<a href="/admin/providers" class="btn-link shrink-0">Manage providers</a>
			</div>
			if len(data.Providers) > 0 {
				@ProviderLedger(data, false)
			} else {
				<div class="ledger-wrap">
					@EmptyState("No upstream providers yet", "This gateway has nowhere to send traffic. Add a provider with its base URL and credential.", "/admin/providers", "Add a provider")
				</div>
			}
		</section>

		<section class="mt-12">
			<div class="flex flex-wrap items-end justify-between gap-3 pb-3">
				<div>
					<h2 class="text-sm font-semibold text-ink">Active routes</h2>
					<p class="mt-1 text-[11px] text-ink-3">Ordered fallback chains. Attempts run left to right until a response is committed.</p>
				</div>
				<a href="/admin/routes" class="btn-link shrink-0">Configure routes</a>
			</div>
			if len(data.Routes) > 0 {
				@RouteLedger(data, false)
			} else {
				<div class="ledger-wrap">
					@EmptyState("No model routes configured", "Without a route, a request only reaches its protocol default. Add an alias to give it an ordered chain.", "/admin/routes", "Add a route")
				</div>
			}
		</section>
	}
}
