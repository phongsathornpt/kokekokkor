package web

templ Defaults(data DashboardData) {
	@AdminShell("kokekokkor admin - protocol defaults", data) {
		@PageTitle("Protocol defaults", "Where a request lands when it matches no model alias. One bound upstream per wire protocol, used as the last resort for that protocol.")

		<section class="mt-8">
			<div class="pb-3">
				<h2 class="text-sm font-semibold text-ink">Bound upstreams</h2>
				<p class="mt-1 text-[11px] text-ink-3">Clearing a default leaves that protocol without a fallback until an exact model route matches.</p>
			</div>

			<div class="ledger-wrap">
				<table class="ledger">
					<thead>
						<tr>
							<th>Protocol</th>
							<th>Bound upstream</th>
							if data.Editable {
								<th>Change</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, def := range data.Defaults {
							<tr>
								<td>@ProtocolCell(def.Protocol)</td>
								<td>@ValueChip(def.ProviderID)</td>
								if data.Editable {
									<td>
										<form class="flex items-end gap-2" method="post" action="/admin/defaults" hx-post="/admin/defaults">
											<div class="min-w-[16rem] flex-1">
												<input type="hidden" name="csrf_token" value={ data.CSRF }/>
												<input type="hidden" name="protocol" value={ def.Protocol }/>
												<label for={ "default-select-" + def.Protocol }>Default provider</label>
												<select id={ "default-select-" + def.Protocol } name="provider_id" class="w-full">
													<option value="" selected?={ def.ProviderID == "" }>-- none (clear) --</option>
													for _, eligible := range def.EligibleProviders {
														<option value={ eligible } selected?={ eligible == def.ProviderID }>{ eligible }</option>
													}
												</select>
											</div>
											<button type="submit" class="btn btn-quiet shrink-0">
												@IconSave("w-3.5 h-3.5")
												Apply
											</button>
										</form>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}
