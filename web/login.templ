package web

templ Login(data LoginData) {
	@Layout("kokekokkor admin login") {
		<div class="grid min-h-screen place-items-center px-6 py-12">
			<div class="w-full max-w-[22rem]">
				<div class="flex items-center gap-2.5">
					<span class="grid h-7 w-7 place-items-center rounded-flat border border-rule-2 bg-plane text-signal">
						@IconLogo("w-4 h-4")
					</span>
					<span class="flex flex-col leading-none">
						<span class="ident font-semibold tracking-tight text-ink">kokekokkor</span>
						<span class="eyebrow mt-1">Gateway administration</span>
					</span>
				</div>

				<div class="mt-8 border border-rule bg-plane p-6 rounded-panel">
					<h1 class="text-sm font-semibold text-ink">Sign in</h1>
					<p class="mb-5 mt-1 text-[11px] text-ink-3">Administrative access to routing, providers, and sealed credentials.</p>

					if data.Message != "" {
						<div class="error mb-4 px-3 py-2" role="alert">
							{ data.Message }
						</div>
					}

					<form method="post" action="/admin/login">
						<div class="flex flex-col gap-4">
							<div>
								<label for="password">Password</label>
								<input id="password" type="password" name="password" autocomplete="current-password" placeholder="Enter admin password" required autofocus class="w-full"/>
							</div>
							<button type="submit" class="btn btn-primary w-full py-2.5">
								<span>Sign in</span>
								@IconArrowRight("w-3.5 h-3.5")
							</button>
						</div>
					</form>
				</div>

				<p class="mt-5 flex items-center gap-2 text-[11px] text-ink-3">
					@IconShield("w-3.5 h-3.5 shrink-0")
					<span>AES-256 encrypted credential store. Secrets are never rendered.</span>
				</p>
			</div>
		</div>
	}
}
