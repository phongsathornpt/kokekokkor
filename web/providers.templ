package web

import "strconv"

templ Providers(data DashboardData) {
	@AdminShell("kokekokkor admin - providers", data) {
		@PageTitle("Providers", "Upstream targets this gateway routes to. Credentials are sealed in the vault and never rendered here.")

		<section class="mt-8">
			<div class="flex flex-wrap items-end justify-between gap-3 pb-3">
				<div>
					<h2 class="text-sm font-semibold text-ink">
						Configured providers <span class="num text-ink-3">({ strconv.Itoa(len(data.Providers)) })</span>
					</h2>
					<p class="mt-1 text-[11px] text-ink-3">Enable, disable, or reconfigure a target. Disabled providers stay configured but receive no traffic.</p>
				</div>
				if data.Editable {
					<button type="button" onclick="document.getElementById('add-provider-dialog')?.showModal()" class="btn btn-primary shrink-0">
						@IconPlus("w-3.5 h-3.5")
						<span>Add provider</span>
					</button>
				}
			</div>

			if len(data.Providers) > 0 {
				@ProviderLedger(data, true)
			} else {
				<div class="ledger-wrap">
					@EmptyState("No providers configured", "A provider is an upstream base URL plus a credential. Add one before routing traffic.", "#add-provider", "Add a provider")
				</div>
			}
		</section>

		if data.Editable {
			<dialog id="add-provider-dialog" class="modal-dialog" aria-labelledby="add-provider-title" onclick="if(event.target===this)this.close()">
				<div id="add-provider" class="modal-panel border border-rule bg-plane p-6 rounded-panel shadow-2xl w-full">
					<div class="flex items-center justify-between pb-3 mb-4 border-b border-rule">
						<div class="flex items-center gap-2">
							<span class="grid h-6 w-6 place-items-center rounded-flat border border-rule-2 bg-plane-2 text-signal">
								@IconServer("w-3.5 h-3.5")
							</span>
							<h2 id="add-provider-title" class="text-sm font-semibold text-ink">Add provider</h2>
						</div>
						<button type="button" onclick="this.closest('dialog').close()" class="btn-link text-ink-3 hover:text-ink-2 text-lg leading-none" aria-label="Close dialog">
							&times;
						</button>
					</div>
					<p class="mb-4 text-[11px] text-ink-3">Provider IDs must be unique across protocols. The credential is sealed on save and never read back.</p>

					<!-- Modal-local error banner -->
					<div id="add-provider-alert" class="hidden error mb-4 px-3 py-2" role="alert"></div>

					<form class="flex flex-col gap-4" method="post" action="/admin/providers" hx-post="/admin/providers" hx-on::before-request="var el=document.getElementById('add-provider-alert');if(el){el.classList.add('hidden');el.innerText='';}" hx-on::after-request="if(!event.detail.successful){var el=document.getElementById('add-provider-alert');if(el){el.innerText=event.detail.xhr.responseText;el.classList.remove('hidden');}}">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							<div>
								<label for="new-provider-id">Provider ID</label>
								<input id="new-provider-id" name="provider_id" placeholder="provider id" required class="w-full"/>
							</div>
							<div>
								<label for="new-protocol">Protocol</label>
								<select id="new-protocol" name="protocol" required class="w-full">
									<option value="openai">openai</option>
									<option value="anthropic">anthropic</option>
									<option value="gemini">gemini</option>
								</select>
							</div>
						</div>
						<div>
							<label for="new-base-url">Base URL</label>
							<input id="new-base-url" name="base_url" placeholder="https://upstream.example" required class="w-full"/>
						</div>
						if data.CredentialEditable {
							<div>
								<label for="new-api-key">API Key (optional)</label>
								<input id="new-api-key" type="password" name="api_key" placeholder="enter API key" autocomplete="new-password" class="w-full"/>
								<p class="mt-1 text-[11px] text-ink-3">Sealed in the AES-256 vault immediately upon creation.</p>
							</div>
						}
						<div>
							<label for="new-enabled">Status</label>
							<select id="new-enabled" name="enabled" class="w-full">
								<option value="true" selected>enabled</option>
								<option value="false">disabled</option>
							</select>
						</div>
						<div class="flex items-center justify-end gap-3 pt-3 border-t border-rule mt-2">
							<button type="button" onclick="this.closest('dialog').close()" class="btn btn-quiet">
								Cancel
							</button>
							<button type="submit" class="btn btn-primary">
								@IconPlus("w-3.5 h-3.5")
								Add provider
							</button>
						</div>
					</form>
				</div>
			</dialog>
		} else {
			<p class="mt-12 text-[11px] text-ink-3">Catalog editing requires SQLite persistence.</p>
		}
	}
}
