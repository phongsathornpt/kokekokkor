package web

import "strconv"

func findConfiguredProvider(id string, providers []ProviderView) *ProviderView {
	for i := range providers {
		if providers[i].ID == id {
			return &providers[i]
		}
	}
	return nil
}

templ ProviderPresetCard(preset ProviderPreset, data DashboardData) {
	{{ configured := findConfiguredProvider(preset.ID, data.Providers) }}
	<div class="border border-rule bg-plane p-5 rounded-panel flex flex-col justify-between gap-4 shadow-xs">
		<div>
			<div class="flex items-center justify-between pb-2 border-b border-rule">
				<div class="flex items-center gap-2">
					if preset.Protocol == "openai" {
						@IconOpenAI("w-4 h-4 text-openai")
					} else if preset.Protocol == "anthropic" {
						@IconAnthropic("w-4 h-4 text-anthropic")
					} else if preset.Protocol == "gemini" {
						@IconGemini("w-4 h-4 text-gemini")
					} else {
						@IconServer("w-4 h-4 text-signal")
					}
					<span class="text-xs font-semibold text-ink">{ preset.Name }</span>
				</div>
				<span class="tag text-[10px] uppercase font-mono">{ preset.Protocol }</span>
			</div>
			<p class="mt-2 text-[11px] text-ink-3 leading-relaxed">{ preset.Description }</p>
			<div class="mt-2 flex items-center gap-1.5 text-[10px] text-ink-3 font-mono truncate">
				<span class="text-ink-disabled">Endpoint:</span>
				<span class="text-ink-2 truncate">{ preset.BaseURL }</span>
			</div>
			if len(preset.Models) > 0 {
				<div class="mt-2.5 flex flex-wrap items-center gap-1">
					for i, m := range preset.Models {
						if i < 3 {
							<span class="tag text-[9px] font-mono">{ m.ID }</span>
						}
					}
					if len(preset.Models) > 3 {
						<span class="text-[9px] text-ink-3 font-mono font-medium">+{ strconv.Itoa(len(preset.Models) - 3) } models</span>
					}
				</div>
			}
			</div>

		if configured != nil {
			<div class="pt-3 border-t border-rule flex flex-col gap-2">
				<div class="flex items-center justify-between text-[11px]">
					<span class="inline-flex items-center gap-1.5 text-ok font-medium">
						<span class="w-1.5 h-1.5 rounded-flat bg-ok"></span>
						Configured
					</span>
					if configured.APIKey {
						<span class="text-ink-3">Key saved</span>
					} else if configured.OAuthConnected {
						<span class="text-ink-3">OAuth active</span>
					}
				</div>
				<div class="flex items-center gap-2 mt-1">
					<a href={ templ.SafeURL("/admin/providers#" + configured.ID) } class="btn btn-quiet w-full text-center">
						Manage Provider
					</a>
				</div>
			</div>
		} else if data.Editable {
			<div class="pt-3 border-t border-rule">
				<form class="flex flex-col gap-2.5" method="post" action="/admin/providers" hx-post="/admin/providers">
					<input type="hidden" name="csrf_token" value={ data.CSRF }/>
					<input type="hidden" name="provider_id" value={ preset.ID }/>
					<input type="hidden" name="protocol" value={ preset.Protocol }/>
					<input type="hidden" name="base_url" value={ preset.BaseURL }/>
					<input type="hidden" name="enabled" value="true"/>
					if preset.ID != "ollama" {
						<input type="password" name="api_key" placeholder={ "API Key (" + preset.KeyPrefix + ")" } autocomplete="new-password" class="w-full text-xs font-mono"/>
					}
					<div class="flex items-center gap-2">
						<button type="submit" class="btn btn-primary flex-1">
							@IconPlus("w-3.5 h-3.5")
							<span>Connect</span>
						</button>
						if preset.HasOAuth {
							<button type="button" popovertarget={ "oauth-modal-" + preset.ID } class="btn btn-quiet">
								OAuth
							</button>
						}
					</div>
				</form>
				if preset.HasOAuth {
					@OAuthModal(ProviderView{ID: preset.ID, Protocol: preset.Protocol, BaseURL: preset.BaseURL, Enabled: true, OAuthAvailable: true, OAuthFlowType: PresetOAuthFlowType(preset.ID)}, data.CSRF)
				}
			</div>
		}
	</div>
}

templ Providers(data DashboardData) {
	@AdminShell("kokekokkor admin - providers", data) {
		@PageTitle("Providers", "Upstream targets this gateway routes to. Credentials are sealed in the vault and never rendered here.")

		<section class="mt-8">
			<div class="flex flex-wrap items-end justify-between gap-3 pb-3">
				<div>
					<h2 class="text-sm font-semibold text-ink">
						Configured providers <span class="num text-ink-3">({ strconv.Itoa(len(data.Providers)) })</span>
					</h2>
					<p class="mt-1 text-[11px] text-ink-3">Enable, disable, or reconfigure a target. Disabled providers stay configured but receive no traffic.</p>
				</div>
				if data.Editable {
					<a href="#add-provider-dialog" popovertarget="add-provider-dialog" class="btn btn-quiet shrink-0">
						@IconPlus("w-3.5 h-3.5")
						<span>Custom provider</span>
					</a>
				}
			</div>

			if len(data.Providers) > 0 {
				@ProviderLedger(data, true)
			} else {
				<div class="ledger-wrap">
					if data.Editable {
						@EmptyState("No providers configured", "A provider is an upstream base URL plus a credential. Choose a preset below or add a custom provider to get started.", "#add-provider-dialog", "Add custom provider")
					} else {
						@EmptyState("No providers configured", "A provider is an upstream base URL plus a credential. Catalog editing is disabled.", "", "")
					}
				</div>
			}
		</section>

		<section class="mt-12">
			<div class="flex flex-wrap items-end justify-between gap-3 pb-3 mb-4 border-b border-rule">
				<div>
					<h2 class="text-sm font-semibold text-ink">
						Quick Connect Providers
					</h2>
					<p class="mt-1 text-[11px] text-ink-3">1-click presets with official endpoints and protocols pre-configured. Just enter your API key or connect via OAuth.</p>
				</div>
				if data.Editable {
					<a href="#add-provider-dialog" popovertarget="add-provider-dialog" class="btn btn-quiet shrink-0">
						@IconPlus("w-3.5 h-3.5")
						<span>Add custom provider</span>
					</a>
				}
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				for _, preset := range DefaultProviderPresets() {
					@ProviderPresetCard(preset, data)
				}
			</div>
		</section>

		if data.Editable {
			<div id="add-provider-dialog" popover="auto" class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="add-provider-title">
				<a href="#" class="modal-backdrop" aria-label="Close dialog"></a>
				<div id="add-provider" class="modal-panel border border-rule bg-plane p-6 rounded-panel shadow-2xl relative z-10 w-full max-w-lg">
					<div class="flex items-center justify-between pb-3 mb-4 border-b border-rule">
						<div class="flex items-center gap-2">
							<span class="grid h-6 w-6 place-items-center rounded-flat border border-rule-2 bg-plane-2 text-signal">
								@IconServer("w-3.5 h-3.5")
							</span>
							<h2 id="add-provider-title" class="text-sm font-semibold text-ink">Add custom provider</h2>
						</div>
						<a href="#" popovertarget="add-provider-dialog" popovertargetaction="hide" class="btn-link text-ink-3 hover:text-ink-2 text-lg leading-none" aria-label="Close dialog">
							&times;
						</a>
					</div>
					<p class="mb-4 text-[11px] text-ink-3">Configure any custom OpenAI, Anthropic, or Gemini compatible upstream endpoint.</p>

					<div id="add-provider-alert"></div>

					<form class="flex flex-col gap-4" method="post" action="/admin/providers" hx-post="/admin/providers">
						<input type="hidden" name="csrf_token" value={ data.CSRF }/>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							<div>
								<label for="new-provider-id">Provider ID</label>
								<input id="new-provider-id" name="provider_id" placeholder="e.g. custom-llm" required class="w-full"/>
							</div>
							<div>
								<label for="new-protocol">Protocol</label>
								<select id="new-protocol" name="protocol" required class="w-full">
									<option value="openai">openai</option>
									<option value="anthropic">anthropic</option>
									<option value="gemini">gemini</option>
								</select>
							</div>
						</div>
						<div>
							<label for="new-base-url">Base URL</label>
							<input id="new-base-url" name="base_url" placeholder="https://upstream.example/v1" required class="w-full"/>
						</div>
						if data.CredentialEditable {
							<div>
								<label for="new-api-key">API Key (optional)</label>
								<input id="new-api-key" type="password" name="api_key" placeholder="enter API key" autocomplete="new-password" class="w-full"/>
								<p class="mt-1 text-[11px] text-ink-3">Sealed in the AES-256 vault immediately upon creation.</p>
							</div>
						}
						<div>
							<label for="new-enabled">Status</label>
							<select id="new-enabled" name="enabled" class="w-full">
								<option value="true" selected>enabled</option>
								<option value="false">disabled</option>
							</select>
						</div>
						<div class="flex items-center justify-end gap-3 pt-3 border-t border-rule mt-2">
							<a href="#" popovertarget="add-provider-dialog" popovertargetaction="hide" class="btn btn-quiet">
								Cancel
							</a>
							<button type="submit" class="btn btn-primary">
								@IconPlus("w-3.5 h-3.5")
								Add provider
							</button>
						</div>
					</form>
				</div>
			</div>
		} else {
			<p class="mt-12 text-[11px] text-ink-3">Catalog editing requires SQLite persistence.</p>
		}
	}
}

